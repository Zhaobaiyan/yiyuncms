{
    "name": "doubao/youyun-cms",
    "description": "易云CMS —— 基于 ThinkPHP 8 的现代化企业建站内容管理系统",
    "type": "project",
    "keywords": ["cms", "thinkphp", "企业建站", "内容管理"],
    "license": "MIT",
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.1",
        "topthink/think-captcha": "^3.0",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-trace": "^2.0",
        "topthink/think-view": "^2.0"
    },
    "require-dev": {
        "topthink/think-migration": "^3.0"
    },
    "autoload": {
        "files": [
            "app/common.php"
        ],
        "psr-4": {
            "app\\": "app",
            "extend\\": "extend"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "packagist",
        "type": "composer",
        "url": "https://mirrors.tencent.com/composer/"
    }]
}
